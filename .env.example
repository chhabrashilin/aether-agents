# Copy to .env for local development. Do not commit real secrets.

# API
AETHER_API_HOST=0.0.0.0
AETHER_API_PORT=8000
AETHER_LOG_LEVEL=INFO

# Database (CloudNativePG on CIRRUS; local Postgres or SQLite for development)
# Local without Postgres:
# DATABASE_URL=sqlite:///./aether.db
DATABASE_URL=postgresql+psycopg://aether:aether@localhost:5432/aether_agents

# External data APIs (request keys from respective providers)
# CPCB Real-time AQI via data.gov.in resource 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
DATA_GOV_IN_API_KEY=
# OpenAQ API v3 (hourly history; gaps stay gaps, no interpolation)
OPENAQ_API_KEY=
# NASA FIRMS MAP_KEY for upwind fire context
FIRMS_MAP_KEY=

# Ingest notes:
# - CPCB pollutant_avg/min/max are AQI sub-indices (0–500), not µg/m³.
# - OpenAQ values are concentrations; do not equate them to CPCB sub-indices.
# - EpisodeAgent prefers PM2.5 concentration→CPCB breakpoint mapping when present.

# Optional LLM for Attribution / Critic / Advisory reasoning over structured evidence
# Default path is rule/score-based and works without API keys.
# Live LLM adapter is not invoked in deterministic mode even when enabled.
AETHER_LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Worker
AETHER_WORKER_INTERVAL_SECONDS=900
AETHER_REGION=delhi-nct
# After each ingest tick: fixture | live | off
AETHER_WORKER_PIPELINE=fixture
