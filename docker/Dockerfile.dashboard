# AetherAgents dashboard: static research UI (nginx)
# Build: docker build -f docker/Dockerfile.dashboard -t aether-agents-dashboard:local .
# CIRRUS/Harbor: tag as hub.k8s.ucar.edu/<project>/aether-agents-dashboard:<tag>

FROM nginx:1.27-alpine

COPY apps/dashboard/index.html /usr/share/nginx/html/index.html
COPY apps/dashboard/styles.css /usr/share/nginx/html/styles.css
COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf

# Listen on 8080 (non-privileged); workers drop to nginx via image defaults
RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
